# Public domain Caddy gets a free Let's Encrypt certificate for (needs DNS pointed at
# this server and ports 80/443 reachable). DuckDNS (free) works fine here, e.g.
# yourname.duckdns.org — see docs/DEPLOYMENT.md.
DOMAIN=

# Web app / auth / DB / storage
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 once Caddy is terminating real TLS in front of this app — must be 1 in production,
# since login over plain HTTP is not acceptable once this is public.
FORCE_HTTPS=0
# Used directly by the app when running natively (no Docker). Under docker-compose, the
# app container's DATABASE_URL is instead built from POSTGRES_USER/PASSWORD/DB below —
# keep these two in sync if you change one.
DATABASE_URL=postgresql://antiquary:CHANGE_ME@localhost:5432/antiquary
POSTGRES_USER=antiquary
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=antiquary
# Seeds the one admin account on first `flask seed-admin` run — change the password
# immediately after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MinIO / S3-compatible object storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=antiquary-videos
S3_REGION=us-east-1

# Ollama (local, free — no key needed, just the running container)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: use a different/stronger model to fact-check the script than the one that
# wrote it (same-model self-review misses more of its own hallucinations). Defaults to
# OLLAMA_MODEL if unset.
OLLAMA_FACTCHECK_MODEL=

# Pexels (free tier) — used to source background images/footage
PEXELS_API_KEY=

# Additional media sources (pipeline/fetch_visuals.py) — every one below is optional;
# the app runs correctly with any/all of them unset, that source is just silently
# skipped (same graceful-degradation pattern as PEXELS_API_KEY above). Wikidata,
# Wikimedia Commons, Internet Archive, and NASA Images need no key at all and are
# always active.

# Europeana (real European museum/archive/library aggregator) — free instant signup
# at https://apis.europeana.eu/. Works right now without a key too, via Europeana's
# own published public demo key ("api2demo") — set this once you have your own for a
# higher, non-shared rate limit.
EUROPEANA_API_KEY=

# Flickr Commons ("no known copyright restrictions" institutional uploads only, not
# Flickr generally) — free instant signup at https://www.flickr.com/services/api/.
FLICKR_API_KEY=

# Google Custom Search JSON API, license-filtered to public-domain/CC images — the
# real, legitimate version of "search Google Images" (raw Google Images results carry
# no reuse rights at all). Needs BOTH a key and a Search Engine ID:
#   1. Create a Custom Search Engine at https://programmablesearchengine.google.com/
#      — set it to "search the entire web" and enable image search.
#   2. Get an API key at https://console.cloud.google.com/apis/credentials (enable the
#      "Custom Search API").
# Free tier: 100 queries/day. Paid beyond that.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Telegram bot — used for the human approval step (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (free, quota-limited) — OAuth client from Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API (free, requires Business account + Meta App Review)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# Instagram publishing needs the finished video at a public URL — fill in once you pick
# a free host (e.g. Cloudflare R2 free tier, or a Cloudflare Tunnel to ./media/output)
PUBLIC_MEDIA_BASE_URL=
