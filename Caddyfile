# HTTP/3 (QUIC, over UDP) disabled globally: some mobile carriers/networks drop UDP
# traffic, and a browser that sees Caddy's default Alt-Svc h3 advertisement will try
# QUIC first and can hang before falling back to HTTP/2 over TCP — confirmed as the
# cause of the site failing to load on mobile data while a plain curl (which never
# attempts HTTP/3) worked fine. This must be a global options block (its own top-level
# `{ }`, before any site block) — `servers` is not a valid directive inside a site block.
{
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode gzip

	# Everything under /api/* goes to the Flask JSON API.
	handle /api/* {
		reverse_proxy app:8787
	}

	# Server/container resource metrics (Netdata). Gated by the same admin login as the
	# app itself — no separate password to manage. forward_auth forwards the incoming
	# request (including the browser's session cookie) to /api/auth/admin-check; a 2xx
	# there lets the request through to Netdata, anything else blocks it with that same
	# status. handle_path strips the /stats prefix before proxying — Netdata itself has
	# no idea it's being served from a subpath.
	handle_path /stats/* {
		forward_auth app:8787 {
			uri /api/auth/admin-check
		}
		reverse_proxy netdata:19999
	}

	# Everything else is the built React SPA. try_files falls back to index.html for
	# any path that isn't a real static file, so client-side routes (e.g. /review)
	# still work on a hard refresh, not just client-side navigation.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
